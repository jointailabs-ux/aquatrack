# AquaTrack ERP — Environment Configuration Template
# Copy this file to .env.local and populate with your credentials.
# STRICT SECURITY WARNING: NEVER commit .env.local to Git or expose privileged keys.

# ==============================================================================
# Public Supabase Configuration (Client-side accessible in browser)
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-anon-key-placeholder

# ==============================================================================
# Privileged Supabase Configuration (Server-side ONLY — NEVER expose to browser)
# ==============================================================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key-placeholder

# ==============================================================================
# Direct / Pooled PostgreSQL Database URL (Server-side ONLY)
# Used for direct database connections, ORM/query tooling, and migrations
# ==============================================================================
DATABASE_URL=your-database-connection-string-placeholder
